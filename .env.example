# Token du bot (Discord Developer Portal → ton application → Bot → Reset Token).
# Ne le partage jamais : celui qui l'a contrôle ton bot.
DISCORD_TOKEN=

# Salon où le bot poste les alertes automatiques (clic droit sur le salon → Copier l'identifiant).
# Vide = pas d'alertes automatiques, commandes seules.
CHANNEL_ID=

# Ton serveur (clic droit sur le serveur → Copier l'identifiant).
# Recommandé : les commandes / apparaissent immédiatement au lieu d'attendre jusqu'à 1 h.
GUILD_ID=

# Ton identifiant Discord. Renseigné = bot privé, toi seul peux l'utiliser.
# Vide = tous les membres du serveur peuvent l'utiliser (lis le cadre légal du README avant).
OWNER_ID=

# Montant maximum par achat, en euros.
BUDGET_MAX=50

# Flat tax sur les plus-values, en %. À vérifier chaque année sur impots.gouv.fr.
TAUX_PFU=31.4
